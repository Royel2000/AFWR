{
  "name": "envio-facil-backend",
  "version": "1.0.0",
  "description": "Backend TypeScript con Clean Architecture para el sistema logístico Envío Fácil",
  "main": "dist/infrastructure/main.js",
  "scripts": {
    "dev": "tsx watch src/infrastructure/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/infrastructure/main.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "keywords": [
    "clean-architecture",
    "typescript",
    "express",
    "logistics",
    "openapi"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
